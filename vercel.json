{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "{api/server.cjs,firebase-applet-config.json,db.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/TokoSipil_Official_v1.0.0.apk",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
