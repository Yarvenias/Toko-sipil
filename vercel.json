{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": [
        "app-server.ts",
        "server/db.ts",
        "src/types.ts",
        "firebase-applet-config.json",
        "db.json"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/TokoSipil_Official_v1.0.0.apk",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
